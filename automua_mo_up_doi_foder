-- Giải mã Remotes Name (Dehash)
local function dehash()
    pcall(function()
        local mapping = debug.getupvalue(RouterClient.init, 7)
        for name, remote in pairs(mapping) do
            if typeof(remote) == "Instance" then remote.Name = name end
        end
    end)
end

-- Hàm lấy hòm đồ hiện tại
local function getInventory()
    return ClientData.get("inventory") or {}
end

-- Đếm số lượng box cụ thể đang có trong túi đồ
local function getBoxCount()
    local inv = getInventory()
    local count = 0
    if inv.gifts then
        for _, info in pairs(inv.gifts) do
            if info.kind == "summer_2026_acorn_box" then
                count = count + 1
            end
        end
    end
    State.BoxCount = count
    return count
end

local function waitForBoxCountBelow(countBefore, timeout)
    local startTime = os.clock()
    while os.clock() - startTime < timeout do
        local currentCount = getBoxCount()
        if currentCount < countBefore then
            return true, currentCount
        end
        task.wait(0.15)
    end
    return false, getBoxCount()
end

-- =======================================================
-- BƯỚC 1: MUA TỪNG BOX CHÉC KHO (LOGIC MỚI)
-- =======================================================
local function doAutoBuy()
    State.CurrentStep = "BƯỚC 1: MUA BOX"
    print("[Bước 1] Bắt đầu mua từng box và theo dõi kho đồ...")
    
    local failCount = 0
    
    while true do
        local countBefore = getBoxCount()
        
        -- Gửi lệnh mua 1 box
        pcall(function()
            API:WaitForChild("ShopAPI/BuyItem"):InvokeServer("gifts", "summer_2026_acorn_box", { buy_count = 1 })
        end)
        task.wait(1.2) -- Đợi server đồng bộ dữ liệu kho đồ
        
        local countAfter = getBoxCount()
        
        -- Nếu số lượng box không tăng lên sau khi mua
        if countAfter <= countBefore then
            failCount = failCount + 1
            State.StatusMessage = string.format("Mua không tăng (%d/2). Thử lại...", failCount)
            print("[Kiểm tra] Số lượng box không tăng. Thử lại lần: " .. failCount)
        else
            failCount = 0 -- Reset nếu mua thành công
            State.StatusMessage = "Mua thành công 1 Box. Tiếp tục..."
        end
        
        -- Nếu 2 lần liên tiếp số lượng không đổi -> Coi như hết tiền hoặc lỗi
        if failCount >= 2 then
            print("[Bước 1] Xác nhận đã hết Acorns hoặc lỗi mua liên tiếp. Dừng mua.")
            State.StatusMessage = "Hết tiền hoặc lỗi mua. Chuyển bước!"
            break
        end
        
        task.wait(0.3)
    end
end

-- =======================================================
-- BƯỚC 2: MỞ TOÀN BỘ BOX CHO ĐẾN KHI TRỐNG TÚI
-- =======================================================
local function doAutoOpen()
    local failedOpenCount = 0
    State.CurrentStep = "BƯỚC 2: MỞ BOX"
    print("[Bước 2] Bắt đầu tiến trình mở sạch box trong túi...")
    
    while true do
        local inv = getInventory()
        local boxId = nil
        
        if inv.gifts then
            for id, info in pairs(inv.gifts) do
                if info.kind == "summer_2026_acorn_box" then
                    boxId = id
                    break
                end
            end
        end
        
        -- Nếu không tìm thấy bất kỳ ID box nào nữa -> Đã mở xong
        if not boxId then
            print("[Bước 2] Đã mở toàn bộ box thành công.")
            State.StatusMessage = "Đã mở hết sạch Box!"
            break
        end
        
        local countBefore = getBoxCount()
        State.StatusMessage = string.format("Check box truoc khi mo: %d", countBefore)
        print("[Step 2] Box before open:", countBefore, "Box ID:", boxId)
        while equipLock do task.wait(0.5) end
        equipLock = true
        local ok, err = pcall(function()
            State.StatusMessage = "Dang equip Box ID: " .. string.sub(boxId, 1, 6)
            API:WaitForChild("ToolAPI/Equip"):InvokeServer(boxId, { use_sound_delay = true, equip_as_last = false })
            task.wait(0.25)
            State.StatusMessage = "Dang xac nhan mo Box..."
            API:WaitForChild("ToolAPI/ServerUseTool"):InvokeServer(boxId, "START")
            task.wait(0.35)
            API:WaitForChild("ToolAPI/Unequip"):InvokeServer(boxId)
            task.wait(0.1)
            API:WaitForChild("ToolAPI/ServerUseTool"):InvokeServer(boxId, "END")
            task.wait(0.1)
            API:WaitForChild("LootBoxAPI/ExchangeItemForReward"):InvokeServer("summer_2026_acorn_box", boxId)
        end)
        equipLock = false
        local opened, countAfter = waitForBoxCountBelow(countBefore, 2)
        print("[Step 2] Box after open:", countAfter, "Opened:", opened)
        if not ok or not opened then
            failedOpenCount = failedOpenCount + 1
            State.StatusMessage = string.format("Open box failed (%d/3). Retrying...", failedOpenCount)
            print("[Step 2] Open box failed:", err or "Box count did not decrease")
            if failedOpenCount >= 3 then
                State.StatusMessage = "Open box failed 3 times. Stop to avoid loop."
                break
            end
        else
            failedOpenCount = 0
        end
        
        getBoxCount() -- Cập nhật số lượng lên UI
        task.wait(0.15)
    end
end

-- =======================================================
-- BƯỚC 3: UP POTION VÀ LAI TẠO NEON FULL TUỔI (LOGIC CŨ)
-- =======================================================
local function doAutoFusionAndPotion()
    State.CurrentStep = "BƯỚC 3: UP POTION & NEON"
    print("[Bước 3] Tiến hành kiểm tra và nâng cấp Wizard...")
    
    while true do
        local inv = getInventory()
        
        local potions = {}
        if inv.food then
            for id, info in pairs(inv.food) do
                if info.kind == "pet_age_potion" then table.insert(potions, id) end
            end
        end
        State.PotionCount = #potions
        
        local normalWizards = {}
        local neonWizards = {}
        
        if inv.pets then
            for id, info in pairs(inv.pets) do
                if info.kind == "summer_2026_acorn_wizard" then
                    local props = info.properties or {}
                    local age = tonumber(props.age or 1) or 1
                    local isMega = props.mega_neon == true
                    local isNeon = props.neon == true
                    
                    if not isMega then
                        if isNeon then
                            if age < 6 then table.insert(neonWizards, { id = id, age = age }) end
                        else
                            table.insert(normalWizards, { id = id, age = age })
                        end
                    end
                end
            end
        end
        
        table.sort(normalWizards, function(a,b) return a.age > b.age end)
        table.sort(neonWizards, function(a,b) return a.age > b.age end)
        
        -- ĐIỀU KIỆN 1: Nuôi nốt Neon chưa max tuổi
        if #neonWizards > 0 and #potions >= 7 then
            local targetNeon = neonWizards[1]
            local needed = 6 - targetNeon.age
            if needed > 0 and #potions >= needed then
                State.StatusMessage = "Đang đập thuốc cho Neon Wizard..."
                pcall(function()
                    API:WaitForChild("ToolAPI/Equip"):InvokeServer(targetNeon.id)
                    task.wait(0.3)
                    for k = 1, needed do
                        local potId = potions[k]
                        API:WaitForChild("ToolAPI/Equip"):InvokeServer(potId, { use_sound_delay = false, equip_as_last = false })
                        task.wait(0.3)
                        API:WaitForChild("PetObjectAPI/CreatePetObject"):InvokeServer("__Enum_PetObjectCreatorType_2", {
                            additional_consume_uniques = {}, pet_unique = targetNeon.id, unique_id = potId
                        })
                        task.wait(0.3)
                        local petObjects = workspace:FindFirstChild("PetObjects")
                        local obj = petObjects and petObjects:FindFirstChild("AgePotion")
                        if obj then API:WaitForChild("PetAPI/ConsumeFoodObject"):FireServer(obj, targetNeon.id) end
                        task.wait(0.4)
                    end
                end)
                task.wait(1)
                continue
            end
        end
        
        -- ĐIỀU KIỆN 2: Gom đủ 4 con thường + trọn gói thuốc để lên thẳng Neon Max Tuổi
        if #normalWizards >= 4 then
            local tempNeededPotions = 0
            local mats = {}
            for idx = 1, 4 do
                table.insert(mats, normalWizards[idx].id)
                tempNeededPotions = tempNeededPotions + (6 - normalWizards[idx].age)
            end
            tempNeededPotions = tempNeededPotions + 7
            
            if #potions >= tempNeededPotions then
                State.StatusMessage = "Đủ điều kiện! Đang up max 4 pet thường..."
                for idx = 1, 4 do
                    local petId = normalWizards[idx].id
                    local currentAge = normalWizards[idx].age
                    local pNeeded = 6 - currentAge
                    
                    if pNeeded > 0 then
                        pcall(function()
                            API:WaitForChild("ToolAPI/Equip"):InvokeServer(petId)
                            task.wait(0.3)
                            for k = 1, pNeeded do
                                local potId = table.remove(potions, 1)
                                API:WaitForChild("ToolAPI/Equip"):InvokeServer(potId, { use_sound_delay = false, equip_as_last = false })
                                task.wait(0.3)
                                API:WaitForChild("PetObjectAPI/CreatePetObject"):InvokeServer("__Enum_PetObjectCreatorType_2", {
                                    additional_consume_uniques = {}, pet_unique = petId, unique_id = potId
                                })
                                task.wait(0.3)
                                local petObjects = workspace:FindFirstChild("PetObjects")
                                local obj = petObjects and petObjects:FindFirstChild("AgePotion")
                                if obj then API:WaitForChild("PetAPI/ConsumeFoodObject"):FireServer(obj, petId) end
                                task.wait(0.4)
                            end
                        end)
                    end
                end
                
                State.StatusMessage = "Đang tiến hành hợp thể DoNeonFusion..."
                pcall(function()
                    API:WaitForChild("PetAPI/DoNeonFusion"):InvokeServer(mats)
                end)
                State.NeonCount = State.NeonCount + 1
                task.wait(2)
                continue
            end
        end
        
        State.StatusMessage = "Hoàn thành nâng cấp tối đa."
        print("[Bước 3] Hoàn tất quá trình nâng cấp tối đa.")
        break
    end
end


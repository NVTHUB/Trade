    end

    local lblStep = mkRow("Tiến trình: Khởi tạo", Color3.fromRGB(255, 180, 200))
    local lblStatus = mkRow("Trạng thái: Đang chờ...", Color3.fromRGB(200, 220, 255))
    local lblStats = mkRow("Kho đồ: 🔄 Đang quét dữ liệu...", Color3.fromRGB(240, 240, 240))

    -- Vòng lặp cập nhật dữ liệu liên tục lên giao diện
    task.spawn(function()
        while gui.Parent do
            lblStep.Text = "  📌 Tiến trình: " .. State.CurrentStep
            lblStatus.Text = "  ⚡ Trạng thái: " .. State.StatusMessage
            lblStats.Text = string.format("  📦 Trong túi: %d Box | %d Potion | Đã tạo: %d Neon", State.BoxCount, State.PotionCount, State.NeonCount)
            task.wait(0.5)
        end
    end)
end


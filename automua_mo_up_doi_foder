    end
    State.StatusMessage = "Đang gửi lệnh ChangeToFolder..."
    local folderFrom = getgenv().Config["Folder_From"] and getgenv().Config["Folder_From"][1]
    local toFolder = getgenv().Config["Folder_To"] and getgenv().Config["Folder_To"][1]
    local folderClient = rawget(getgenv(), "client")

    if folderFrom and toFolder and folderClient and type(folderClient.ChangeToFolder) == "function" then

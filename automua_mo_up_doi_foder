-- BƯỚC 4: CHỜ 1 PHÚT RỒI ĐỔI FOLDER
-- =======================================================
local function doChangeFolder()
    State.CurrentStep = "BƯỚC 4: CHỜ & ĐỔI ACC"
    State.StatusMessage = "Đang chờ 60 giây trước khi đổi folder..."
    print("[Bước 4] Bắt đầu chờ 60 giây trước khi đổi folder...")

    -- Đếm ngược chờ đúng 1 phút (60 giây) trước khi đổi Folder
    for timeLeft = 60, 1, -1 do
        State.StatusMessage = string.format("Đổi Folder sau %ds...", timeLeft)
        task.wait(1)
    end

    -- Tiến hành đổi Folder sang tài khoản kế tiếp
    State.StatusMessage = "Đang gởi lệnh ChangeToFolder..."
    local folderFrom = g.Config and g.Config["Folder_From"] and g.Config["Folder_From"][1]
    local folderTo = g.Config and g.Config["Folder_To"] and g.Config["Folder_To"][1]
    local folderClient = rawget(getgenv(), "client")

    if folderFrom and folderTo and folderClient and type(folderClient.ChangeToFolder) == "function" then
        local ok, err = pcall(function()
            folderClient:ChangeToFolder(
                folderFrom,
                folderTo,
                false,
                nil
            )
        end)
        if ok then
            State.StatusMessage = "Đổi tài khoản thành công!"
        else
            State.StatusMessage = "Lỗi khi đổi folder"
            warn("[Lỗi] ChangeToFolder thất bại:", err)
        end
    else
        State.StatusMessage = "Lỗi: Thiếu cấu hình Folder!"
        warn("[Lỗi] Không đổi được folder: Thiếu cấu hình Folder hoặc thiếu client đổi folder")
    end
end


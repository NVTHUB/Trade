local function getInventory()
    return ClientData.get("inventory") or {}
end

-- TỐI ƯU: Quét toàn bộ hòm đồ để không sót bất kỳ danh mục nào (Gifts, Vạn vật)
local function checkItemCount(itemName)
    local inv = getInventory()
    local count = 0
    for category, items in pairs(inv) do
        if type(items) == "table" then
            for _, info in pairs(items) do
                if type(info) == "table" and info.kind == itemName then 
                    count = count + 1 
                end
            end
        end
    end
    return count
end

local function updateBoxStats()
    local inv = getInventory()
    local totalBoxes = 0
    local allowedItems = getgenv().Config.TuMoBox.Items or {}
    local allowedMap = {}
    for _, v in ipairs(allowedItems) do allowedMap[v] = true end
    
    if inv.gifts then
        for _, info in pairs(inv.gifts) do
            if allowedMap[info.kind] then totalBoxes = totalBoxes + 1 end
        end
    end
    State.BoxCount = totalBoxes
    return totalBoxes
end

-- TỐI ƯU: Nhận diện chính xác mục tiêu mua thuộc danh mục nào dựa trên cấu trúc game, mặc định thông minh là gifts nếu tên có chứa "box" hoặc "gift"
local function detectCategory(itemName)
    local inv = getInventory()
    for category, items in pairs(inv) do
        if type(items) == "table" then
            for _, info in pairs(items) do
                if type(info) == "table" and info.kind == itemName then 
                    return category 
                end
            end
        end
    end
    
    -- Nếu item chưa có sẵn trong người để quét, tự động phân loại thông minh bằng text tên
    local lowerName = string.lower(itemName)
    if string.find(lowerName, "box") or string.find(lowerName, "gift") or string.find(lowerName, "egg") then
        return "gifts"
    end
    return "pets"
end

local function getPotionIds()
    local inv = getInventory()
    local pots = {}
    if inv.food then
        for id, info in pairs(inv.food) do
            if info.kind == "pet_age_potion" then table.insert(pots, id) end
        end
    end
    State.PotionCount = #pots
    return pots
end

local function feedPotionToPet(petId, neededPotions)
    local pots = getPotionIds()
    if #pots == 0 or neededPotions <= 0 then return false end
    
    local batchSize = math.min(#pots, neededPotions)
    local mainPotionId = pots[1]
    local additional = {}
    for i = 2, batchSize do table.insert(additional, pots[i]) end

    local success = pcall(function()
        API:WaitForChild("ToolAPI/Equip"):InvokeServer(petId)
        task.wait(0.3)
        API:WaitForChild("ToolAPI/Equip"):InvokeServer(mainPotionId, { use_sound_delay = false, equip_as_last = false })
        task.wait(0.3)
        API:WaitForChild("PetObjectAPI/CreatePetObject"):InvokeServer("__Enum_PetObjectCreatorType_2", {
            additional_consume_uniques = additional,
            pet_unique = petId,
            unique_id = mainPotionId
        })
        task.wait(0.3)
        local petObjects = workspace:FindFirstChild("PetObjects")
        local obj = petObjects and petObjects:FindFirstChild("AgePotion")
        if obj then API:WaitForChild("PetAPI/ConsumeFoodObject"):FireServer(obj, petId) end
    end)
    task.wait(1.2)
    return success
end

local function doAutoBuy()
    if not (getgenv().Config.AutoMua and getgenv().Config.AutoMua.Enabled) then return end
    State.CurrentStep = "BƯỚC 1: AUTO MUA"
    local items = getgenv().Config.AutoMua.SelectedItems or {}
    
    for _, itemName in ipairs(items) do
        local category = detectCategory(itemName)
        local failCount = 0
        while true do
            local before = checkItemCount(itemName)
            State.StatusMessage = string.format("Đang mua [%s]: %s", category, itemName)
            pcall(function()
                API:WaitForChild("ShopAPI/BuyItem"):InvokeServer(category, itemName, { buy_count = 1 })
            end)
            task.wait(1.5) -- Đúc kết độ trễ an toàn để server cộng quà vào túi
            
            local after = checkItemCount(itemName)
            if after <= before then 
                failCount = failCount + 1 
            else 
                failCount = 0 
            end
            
            if failCount >= 3 then 
                print("[Shop] Dừng mua do số lượng không tăng hoặc hết tiền.")
                break 
            end
            task.wait(0.3)
        end
    end
end

local function doBuyByAmount()
    if not (getgenv().Config.MuaTheoSoluong and getgenv().Config.MuaTheoSoluong.Enabled) then return end
    State.CurrentStep = "BƯỚC 2: MUA THEO SỐ LƯỢNG"
    local items = getgenv().Config.MuaTheoSoluong.SelectedItems or {}
    local amounts = getgenv().Config.MuaTheoSoluong.BuyAmounts or {}
    
    for i, itemName in ipairs(items) do
        local targetAmount = tonumber(amounts[i]) or 0
        if targetAmount > 0 then
            local category = detectCategory(itemName)
            local failCount = 0
            while checkItemCount(itemName) < targetAmount do
                local before = checkItemCount(itemName)
                State.StatusMessage = string.format("Mua %s: %d/%d", itemName, before, targetAmount)
                pcall(function()
                    API:WaitForChild("ShopAPI/BuyItem"):InvokeServer(category, itemName, { buy_count = 1 })
                end)
                task.wait(1.5)
                
                if checkItemCount(itemName) <= before then
                    failCount = failCount + 1
                    if failCount >= 3 then break end
                else
                    failCount = 0
                end
            end
        end
    end
end

local function doAutoOpen()
    if not (getgenv().Config.TuMoBox and getgenv().Config.TuMoBox.Enabled) then return end
    State.CurrentStep = "BƯỚC 3: MỞ HỘP"
    local allowedItems = getgenv().Config.TuMoBox.Items or {}
    local allowedMap = {}
    for _, v in ipairs(allowedItems) do allowedMap[v] = true end
    
    while true do
        updateBoxStats()
        local inv = getInventory()
        local boxId, boxKind = nil, nil
        if inv.gifts then
            for id, info in pairs(inv.gifts) do
                if allowedMap[info.kind] then boxId, boxKind = id, info.kind; break end
            end
        end
        if not boxId then break end
        
        while equipLock do task.wait(0.5) end
        equipLock = true
        pcall(function()
            API:WaitForChild("ToolAPI/Equip"):InvokeServer(boxId, { use_sound_delay = true, equip_as_last = false })
            task.wait(0.25)
            API:WaitForChild("ToolAPI/ServerUseTool"):InvokeServer(boxId, "START")
            task.wait(0.35)
            API:WaitForChild("ToolAPI/Unequip"):InvokeServer(boxId)
            task.wait(0.1)
            API:WaitForChild("ToolAPI/ServerUseTool"):InvokeServer(boxId, "END")
            task.wait(0.1)
            API:WaitForChild("LootBoxAPI/ExchangeItemForReward"):InvokeServer(boxKind, boxId)
        end)
        equipLock = false
        task.wait(1.5)
    end
end

local function doAutoPotionAndFusion()
    if not (getgenv().Config.AutoPotion and getgenv().Config.AutoPotion.Enabled) then 
        State.CurrentStep = "BƯỚC 4: AUTO POTION"
        State.StatusMessage = "Bỏ qua (Disabled)" 
        return 
    end

    State.CurrentStep = "BƯỚC 4: AUTO POTION"
    local selectedPets = getgenv().Config.AutoPotion.SelectedPets or {}
    
    for _, targetKind in ipairs(selectedPets) do
        local currentPetLoop = true
        
        while currentPetLoop do
            task.wait(0.5)
            local inv = getInventory()
            if not inv or not inv.pets then break end
            
            local normalPets = {}
            local neonNotFull = {}
            local neonFull = {}
            local sampleInfo = nil

            for id, info in pairs(inv.pets) do
                if info.kind == targetKind then
                    if not sampleInfo then sampleInfo = info end
                    local props = info.properties or {}
                    local age = tonumber(props.age or 1) or 1
                    local isNeon = props.neon == true
                    local isMega = props.mega_neon == true

                    if not isMega then
                        if isNeon then
                            if age == 6 then 
                                table.insert(neonFull, id) 
                            else 
                                table.insert(neonNotFull, {id = id, xp = props.xp or 0, info = info}) 
                            end
                        else
                            if age < 6 then 
                                table.insert(normalPets, {id = id, xp = props.xp or 0, info = info}) 
                            end
                        end
                    end
                end
            end

            local rarity = sampleInfo and string.lower(sampleInfo.rarity or sampleInfo.pet_rarity or "common") or "common"
            local maxXP = PET_XP_DATA[rarity] or 2500
            local neonMaxPotsNeeded = math.ceil(maxXP / POTION_XP_VALUE)

            if #neonNotFull > 0 then
                table.sort(neonNotFull, function(a, b) return a.xp > b.xp end)
                local targetNeon = neonNotFull[1]
                local currentPots = getPotionIds()
                local neededPotions = math.max(1, math.ceil((maxXP - targetNeon.xp) / POTION_XP_VALUE))
                
                if #currentPots >= neededPotions then
                    State.StatusMessage = string.format("[%s] Bơm thuốc Neon dở lên Full (%d viên)", targetKind, neededPotions)
                    feedPotionToPet(targetNeon.id, neededPotions)
                else
                    State.StatusMessage = string.format("[%s] Không đủ thuốc up Neon sẵn (%d/%d v). Đổi pet...", targetKind, #currentPots, neededPotions)
                    currentPetLoop = false 
                end

            elseif #normalPets >= 4 then
                table.sort(normalPets, function(a, b) return a.xp > b.xp end)
                local batch = {normalPets[1], normalPets[2], normalPets[3], normalPets[4]}
                
                local totalNormalPotsNeeded = 0
                for _, pData in ipairs(batch) do
                    totalNormalPotsNeeded = totalNormalPotsNeeded + math.max(1, math.ceil((maxXP - pData.xp) / POTION_XP_VALUE))
                end
                
                local totalRequired = totalNormalPotsNeeded + neonMaxPotsNeeded
                local currentPots = getPotionIds()
                
                if #currentPots >= totalRequired then
                    State.StatusMessage = string.format("[%s] Đủ thuốc trọn gói (%d v). Bơm 4 con thường...", targetKind, totalRequired)
                    
                    for _, pData in ipairs(batch) do
                        local needed = math.max(1, math.ceil((maxXP - pData.xp) / POTION_XP_VALUE))
                        feedPotionToPet(pData.id, needed)
                    end
                    
                    State.StatusMessage = "⚡ Đang ghép 4 con thường lên NEON..."
                    local mats = {batch[1].id, batch[2].id, batch[3].id, batch[4].id}
                    pcall(function()
                        API:WaitForChild("PetAPI/DoNeonFusion"):InvokeServer(mats)
                    end)
                    State.NeonCount = State.NeonCount + 1
                    task.wait(2.5) 
                else
                    State.StatusMessage = string.format("[%s] Thiếu thuốc gói lô thường (%d/%d v). Đổi pet...", targetKind, #currentPots, totalRequired)
                    currentPetLoop = false 
                end
            else
                State.StatusMessage = string.format("[%s] Không đủ điều kiện nuôi tiếp. Đổi pet...", targetKind)
                currentPetLoop = false 
            end
        end
    end
    State.StatusMessage = "Hoàn thành toàn bộ danh sách Pet!"
end


    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "A_EventGui"
    gui.ResetOnSpawn = false
    gui.Parent = pg

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(420, 240)
    frame.Position = UDim2.new(0, 15, 0.5, -120)
    frame.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    
    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(230, 110, 160) -- Màu hồng viền sang xịn mịn

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -16, 0, 35)
    title.Position = UDim2.new(0, 12, 0, 8)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = Color3.fromRGB(255, 240, 245)
    title.Text = "🌺 HUB OF TUYEN | AUTOMATION EVENT ❤️"
    title.Parent = frame

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -24, 1, -60)
    holder.Position = UDim2.new(0, 12, 0, 50)
    holder.BackgroundTransparency = 1
    holder.Parent = frame
    
    local list = Instance.new("UIListLayout", holder)
    list.Padding = UDim.new(0, 8)

    local function mkRow(label, color)
        local row = Instance.new("TextLabel")
        row.Size = UDim2.new(1, 0, 0, 38)
        row.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
        row.BorderSizePixel = 0
        row.Font = Enum.Font.GothamSemibold
        row.TextSize = 13
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.TextColor3 = color or Color3.fromRGB(230, 235, 245)
        row.Text = "  " .. label
        row.Parent = holder
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
